export PATH="$HOME/.local/bin:$HOME/.local/opt/dotfiles-js-lsp/node_modules/.bin:$PATH"

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt share_history          # 複数タブで履歴を共有
setopt hist_ignore_all_dups   # 同じコマンドは重複して残さない

autoload -Uz compinit && compinit  # Tab補完を有効化
setopt auto_cd  # ディレクトリ名だけでcdできる

if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

if [[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
    source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi
# source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Private or machine-specific additions stay outside Git.
[[ ! -r "$HOME/.zshrc.local" ]] || source "$HOME/.zshrc.local"
